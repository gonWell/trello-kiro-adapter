# ---- Trello ----
# API Secret da sua aplicação Trello (aba "API Key" em https://trello.com/apps/admin).
# É a MESMA usada como OAuth1 secret. Usada no HMAC-SHA1 do webhook.
TRELLO_SECRET=

# Key e Token da API do Trello (para buscar o card completo: descrição + etiquetas).
TRELLO_KEY=
TRELLO_TOKEN=

# ---- Callback ----
# URL EXATA registrada como callbackURL no Trello (precisa bater byte a byte no HMAC).
CALLBACK_URL=https://trello-adapter.bwdi.online/trello

# ---- Kiro ----
# URL gerada pelo register_hook do Kiro. O adapter faz POST aqui para injetar a tarefa.
KIRO_HOOK_URL=

# ---- Board / Lista ----
BOARD_ID=6a9ec8f34ccc85be73a06467
GO_DEV_LIST_ID=6a9ec907a32d865db292eaf2

# ---- Mapeamento etiqueta -> repo (opcional) ----
# Se a etiqueta já for o nome do repo, deixe {} e ajuste DEFAULT_GH_OWNER.
LABEL_REPO_MAP={}
DEFAULT_GH_OWNER=gonWell

# ---- Segurança ----
# true em produção. Só use false para debug local.
VERIFY_HMAC=true

PORT=3000
